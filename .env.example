# ══════════════════════════════════════════════════════════════
# NIS2 Compliance Analyzer - Environment Variables
# Copy to .env for local dev. Set these in Railway dashboard for production.
# ══════════════════════════════════════════════════════════════

# Django
SECRET_KEY=your-secret-key-here-generate-with-django
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app.railway.app

# Database — Railway sets this automatically when you add PostgreSQL plugin
# Leave empty locally to use SQLite
DATABASE_URL=

# Qdrant — use Qdrant Cloud free tier for Railway deployment
# Leave empty locally to use local on-disk Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# AI — Google Gemini (used for gap analysis via Pydantic AI)
GOOGLE_API_KEY=your-google-api-key-here

# AI — Anthropic Claude (used for PDF report content generation)
ANTHROPIC_API_KEY=sk-ant-your-key-here
